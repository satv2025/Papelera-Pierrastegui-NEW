            if (menuToggle && sidebar && closeBtn) {
                menuToggle.addEventListener('click', () => {
                    sidebar.classList.add('open');
                    document.body.classList.add('scroll-locked');
                });

                closeBtn.addEventListener('click', () => {
                    sidebar.classList.remove('open');
