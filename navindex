            function inicializarCarrusel(producto) {
                const contenedor = producto.querySelector('.contenedor');
                if (!contenedor) return;

                const imgs = Array.from(contenedor.querySelectorAll('img'));
                if (imgs.length === 0) return;

                // Agregar relative si no tiene
                if (getComputedStyle(producto).position === 'static') {
                    producto.style.position = 'relative';
                }

                let index = imgs.findIndex(img => img.classList.contains('visible'));
                if (index === -1) index = 0;

                // Crear botones si no existen
                let prevBtn = producto.querySelector('.carousel-prev');
                let nextBtn = producto.querySelector('.carousel-next');

                if (!prevBtn) {
                    prevBtn = document.createElement('button');
                    prevBtn.className = 'carousel-prev';
                    prevBtn.textContent = '❮';
                    Object.assign(prevBtn.style, {
                        position: 'absolute', top: '50%', transform: 'translateY(-50%)', left: '5px',
                        background: 'rgba(0,0,0,0.5)', color: '#fff', border: 'none', borderRadius: '50%',
                        width: '30px', height: '30px', cursor: 'pointer', zIndex: '5', fontSize: '18px'
                    });
                    producto.appendChild(prevBtn);
                }

                if (!nextBtn) {
                    nextBtn = document.createElement('button');
                    nextBtn.className = 'carousel-next';
                    nextBtn.textContent = '❯';
                    Object.assign(nextBtn.style, {
                        position: 'absolute', top: '50%', transform: 'translateY(-50%)', right: '5px',
                        background: 'rgba(0,0,0,0.5)', color: '#fff', border: 'none', borderRadius: '50%',
                        width: '30px', height: '30px', cursor: 'pointer', zIndex: '5', fontSize: '18px'
                    });
                    producto.appendChild(nextBtn);
                }

                function actualizar() {
                    imgs.forEach((img, i) => {
                        img.style.display = (i === index) ? 'block' : 'none';
                        img.classList.toggle('visible', i === index);
                    });
                    prevBtn.style.display = (index === 0) ? 'none' : 'block';
                    nextBtn.style.display = (index === imgs.length - 1) ? 'none' : 'block';
                }

                prevBtn.onclick = e => { e.stopPropagation(); if (index > 0) { index--; actualizar(); } };
                nextBtn.onclick = e => { e.stopPropagation(); if (index < imgs.length - 1) { index++; actualizar(); } };

                actualizar();
            }

