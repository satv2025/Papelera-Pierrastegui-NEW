            function extraerUrl(onclickStr) {
                const match = onclickStr.match(/window\.location\.href\s*=\s*['"]([^'"]+)['"]/);
                if (!match) return null;
                return match[1].replace(/\.html$/, '');
            }

            document.querySelectorAll('.producto').forEach(producto => {
                if (producto.classList.contains('proximo')) return;
                const btn = producto.querySelector('button.btn');
                if (!btn) return;
                const onclickAttr = btn.getAttribute('onclick');
                if (!onclickAttr) return;
                const url = extraerUrl(onclickAttr);
                if (!url) return;
                if (links.includes(url)) {
                    const nuevoDiv = document.createElement('div');
                    nuevoDiv.classList.add('btn-reset');
                    if (!producto.parentNode) return;
                    producto.parentNode.insertBefore(nuevoDiv, producto);
                    nuevoDiv.appendChild(producto);
                    nuevoDiv.addEventListener('click', () => { window.location.href = url; });
                }
            });


