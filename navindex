            const grid = document.querySelector('.productos-grid');
            if (grid) {
                const productosOriginales = Array.from(grid.querySelectorAll('.producto'));
                const searchInputs = document.querySelectorAll('#search-input');

                function filtrarProductos(query) {
                    grid.innerHTML = '';
                    productosOriginales.forEach(prod => {
                        const nombre = prod.querySelector('.nombre')?.textContent.toLowerCase() || '';
                        const categoria = prod.querySelector('.categoria')?.textContent.toLowerCase() || '';
                        if (!query || nombre.includes(query) || categoria.includes(query)) {
                            grid.appendChild(prod);
                            inicializarCarrusel(prod);
                        }
                    });
                }

                searchInputs.forEach(input => input.addEventListener('input', function () {
                    const query = this.value.toLowerCase().trim();
                    filtrarProductos(query);
                }));
            }


