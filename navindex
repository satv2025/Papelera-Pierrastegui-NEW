<style>
    #snowflakes {
        pointer-events: none;
        position: fixed;
        inset: 0;
        overflow: hidden;
        z-index: 999999;
    }

    .snowflake {
        position: absolute;
        font-size: 30px;
        color: white;
        opacity: 0.9;
    }
</style>

<div id="snowflakes"></div>
<script>function crearCopo() {
        const copo = document.createElement("iconify-icon");
        copo.className = "snowflake";
        copo.setAttribute("icon", "twemoji:snowflake");

        copo.style.left = Math.random() * window.innerWidth + "px";
        copo.style.top = "-60px";
        copo.style.fontSize = (20 + Math.random() * 40) + "px";

        document.getElementById("snowflakes").appendChild(copo);

        gsap.to(copo, {
            y: window.innerHeight + 120,
            x: "+=" + (Math.random() * 100 - 50),
            rotation: Math.random() * 180,
            duration: 5 + Math.random() * 4,
            ease: "none",
            onComplete: () => copo.remove()
        });
    }

    setInterval(crearCopo, 200);
</script>

