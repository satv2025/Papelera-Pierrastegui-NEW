            <script type="module">
                import { supabase } from "https://papelerapierrastegui.com.ar/assets/js/supabaseClient.js";

                const container = document.getElementById("mi-cuenta-container");
                const miCuenta = document.querySelector(".mi-cuenta");
                const icon = miCuenta.querySelector(".icon-right");

                const renderCuenta = (user) => {
                    container.innerHTML = "";

                    if (user) {
                        const nombre =
                            user.user_metadata?.nombre_completo ||
                            user.user_metadata?.username ||
                            user.email;

                        const dropdown = document.createElement("div");
                        dropdown.classList.add("dropdown");

                        const btn = document.createElement("button");
                        btn.textContent = nombre;
                        btn.classList.add("btn-login");

                        const content = document.createElement("div");
                        content.classList.add("dropdown-content");

                        // 🧩 Editar perfil
                        const perfilBtn = document.createElement("button");
                        perfilBtn.innerHTML = `
        <img src="/assets/images/svg/web/edit.svg" alt="Editar" class="icon-dropdown" />
        Editar Perfil
      `;
                        perfilBtn.onclick = () => (window.location.href = "/profile");

                        // 🚪 Cerrar sesión
                        const logoutBtn = document.createElement("button");
                        logoutBtn.innerHTML = `
        <img src="/assets/images/svg/web/exit.svg" alt="Salir" class="icon-dropdown icon-logout" />
        Cerrar Sesión
      `;
                        logoutBtn.onclick = async () => {
                            await supabase.auth.signOut();
                            window.location.reload();
                        };

                        content.appendChild(perfilBtn);
                        content.appendChild(logoutBtn);
                        dropdown.appendChild(btn);
                        dropdown.appendChild(content);
                        container.appendChild(dropdown);

                        // 🎯 Toggle del menú
                        btn.onclick = (e) => {
                            e.stopPropagation();
                            const isOpen = dropdown.classList.toggle("show");

                            // ✅ Manejamos el estado visual en el contenedor principal
                            if (isOpen) {
                                miCuenta.classList.add("open");
                            } else {
                                miCuenta.classList.remove("open");
                            }
                        };

                        // 🔒 Cierra si clickeás fuera
                        window.addEventListener("click", (e) => {
                            if (!dropdown.contains(e.target)) {
                                dropdown.classList.remove("show");
                                miCuenta.classList.remove("open");
                            }
                        });

                        // 👇 Icono también abre perfil
                        icon.onclick = () => (window.location.href = "/profile");
                    } else {
                        const btnAcceder = document.createElement("button");
                        btnAcceder.textContent = "Acceder";
                        btnAcceder.classList.add("btn-login");
                        btnAcceder.onclick = () => (window.location.href = "/login");
                        container.appendChild(btnAcceder);

                        icon.onclick = () => (window.location.href = "/login");
                    }
                };

                const { data: session } = await supabase.auth.getSession();
                renderCuenta(session?.session?.user);

                supabase.auth.onAuthStateChange((_event, session) => {
                    renderCuenta(session?.user);
                });
            </script>
