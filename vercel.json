{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)/",
      "destination": "/$1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1.html"
    }
  ],
  "routes": [
    {
      "src": "/admin/config.yml",
      "dest": "/admin/config.yml"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    }
  ]
}